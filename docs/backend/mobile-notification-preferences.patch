+import { allowsMobileNotice as allows } from './mobile-notification-preferences';
+import { validate } from 'class-validator';
+import { plainToInstance } from 'class-transformer';
+import { UpdateMobilePreferencesDto } from './mobile-push.dto';
+const quiet = { quietEnabled: true, quietStart: 1320, quietEnd: 480, timeZone: 'Asia/Almaty' };
+describe('mobile notification preferences', () => {
+  it('keeps categories independent and calls available', () => {
+    const p = { messages: false, deadlines: false };
+    expect(allows(p, 'message', new Date())).toBe(false);
+    expect(allows(p, 'mention', new Date())).toBe(true);
+    expect(allows(p, 'reminder', new Date())).toBe(false);
+    expect(allows({ ...quiet }, 'call', new Date())).toBe(true);
+  });
+  it('handles midnight, exact boundaries and a full day', () => {
+    expect(allows(quiet, 'message', new Date('2026-11-24T17:00:00Z'))).toBe(false);
+    expect(allows(quiet, 'message', new Date('2026-11-25T02:59:00Z'))).toBe(false);
+    expect(allows(quiet, 'message', new Date('2026-11-25T03:00:00Z'))).toBe(true);
+    expect(allows({ ...quiet, quietEnd:1320 }, 'mention', new Date())).toBe(false);
+  });
+  it('uses the timezone DST rules instead of a frozen offset', () => {
+    const p = {...quiet, timeZone:'Europe/Berlin'};
+    expect(allows(p,'message',new Date('2026-07-01T20:00:00Z'))).toBe(false);
+    expect(allows(p,'message',new Date('2026-01-01T20:00:00Z'))).toBe(true);
+  });
+  it('requires nested preferences and rejects invalid times', async () => {
+    expect((await validate(plainToInstance(UpdateMobilePreferencesDto,{token:'x'.repeat(30)}))).length).toBeGreaterThan(0);
+    expect((await validate(plainToInstance(UpdateMobilePreferencesDto,{token:'x'.repeat(30),preferences:{...quiet,quietStart:1440}}))).length).toBeGreaterThan(0);
+  });
+});
