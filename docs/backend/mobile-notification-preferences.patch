+import { object } from './fcm-client';
+/** Suppressed notices are consumed, never replayed as a morning burst. */
+export function allowsMobileNotice(raw: unknown, type: string, now: Date): boolean {
+  if (type === 'call') return true;
+  const p = object(raw);
+  if (p.quietEnabled === true) {
+    let minute: number;
+    try {
+      const parts = new Intl.DateTimeFormat('en-GB', { timeZone: String(p.timeZone), hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).formatToParts(now);
+      minute = Number(parts.find(p => p.type === 'hour')?.value) * 60 + Number(parts.find(p => p.type === 'minute')?.value);
+    } catch { const local = new Date(now.getTime() + Number(p.utcOffsetMinutes ?? 0) * 60000); minute = local.getUTCHours() * 60 + local.getUTCMinutes(); }
+    const start = Number(p.quietStart ?? 1320), end = Number(p.quietEnd ?? 480);
+    if (start === end || (start < end ? minute >= start && minute < end : minute >= start || minute < end)) return false;
+  }
+  return !(type === 'message' && p.messages === false || type === 'mention' && p.mentions === false || ['deadline', 'reminder', 'planner'].includes(type) && p.deadlines === false);
+}
