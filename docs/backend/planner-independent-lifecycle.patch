diff --git a/src/project-planner/planner-independent-completion.spec.ts b/src/project-planner/planner-independent-completion.spec.ts
new file mode 100644
index 0000000..d2c8186
--- /dev/null
+++ b/src/project-planner/planner-independent-completion.spec.ts
@@ -0,0 +1,104 @@
+import { BadRequestException, ForbiddenException } from '@nestjs/common';
+import { UserRole } from '@prisma/client';
+import { PrismaService } from '../prisma/prisma.service';
+import { ProjectAccessService } from '../project-access/project-access.service';
+import { AuthenticatedRequest } from '../auth/authenticated-request';
+import { ProjectPlannerController } from './project-planner.controller';
+import { ProjectPlannerService } from './project-planner.service';
+
+describe('Independent planner lifecycle', () => {
+  const actor = { id: 'user', role: UserRole.EXECUTOR };
+  function setup(source: 'project' | 'inbox') {
+    const item = {
+      id: 'item', projectId: source === 'project' ? 'project' : null,
+      workspaceId: 'workspace', createdById: actor.id,
+      taskId: source === 'project' ? 'task' : null,
+      inboxTaskId: source === 'inbox' ? 'inbox' : null,
+      assignees: [{ userId: actor.id, excluded: false }],
+      task: source === 'project' ? { projectId: 'project', assignees: [] } : null,
+      inboxTask: source === 'inbox' ? { assignees: [] } : null,
+      scheduledAt: new Date('2026-11-18T10:00:00Z'), durationMinutes: 30,
+    };
+    const db = {
+      project: { findMany: jest.fn().mockResolvedValue([{ id: 'project' }]) },
+      projectTask: { update: jest.fn() },
+      inboxTask: { update: jest.fn() },
+      $queryRaw: jest.fn().mockResolvedValue([]),
+      projectPlannerItem: {
+        findUnique: jest.fn().mockResolvedValue(item),
+        findUniqueOrThrow: jest.fn().mockResolvedValue(item),
+        findMany: jest.fn().mockResolvedValue([]),
+        update: jest.fn().mockImplementation(async args => ({ ...item, ...args.data })),
+      },
+      $transaction: jest.fn(),
+    };
+    db.$transaction.mockImplementation(async callback => callback(db));
+    const access = {
+      assertProjectAccess: jest.fn().mockResolvedValue(undefined),
+      assertWorkspaceAccess: jest.fn().mockResolvedValue(undefined),
+      assertCanEditProject: jest.fn().mockRejectedValue(new Error('Cannot edit source')),
+      getEffectiveRole: jest.fn().mockResolvedValue(UserRole.EXECUTOR),
+      projectFilter: jest.fn().mockResolvedValue({ id: 'project' }),
+    };
+    const service = new ProjectPlannerService(db as unknown as PrismaService, access as unknown as ProjectAccessService);
+    return { db, access, service, item };
+  }
+
+  describe.each(['project', 'inbox'] as const)('%s link', source => {
+    it.each([true, false])('stores completed=%s only on the planner entry', async completed => {
+      const { db, access, service } = setup(source);
+      await expect(service.updateItem('item', actor, { completed })).resolves.toEqual(expect.objectContaining({ completed }));
+      expect(db.projectPlannerItem.update).toHaveBeenCalledWith(expect.objectContaining({ data: { completed } }));
+      expect(db.projectTask.update).not.toHaveBeenCalled();
+      expect(db.inboxTask.update).not.toHaveBeenCalled();
+      expect(access.assertCanEditProject).not.toHaveBeenCalled();
+      expect(access.getEffectiveRole).not.toHaveBeenCalled();
+    });
+
+    it('combines schedule and completion without editing the source', async () => {
+      const { db, service } = setup(source);
+      await service.updateItem('item', actor, { completed: true, durationMinutes: 60 });
+      expect(db.$transaction).toHaveBeenCalledTimes(1);
+      expect(db.projectPlannerItem.update).toHaveBeenCalledWith(expect.objectContaining({ data: { completed: true, durationMinutes: 60 } }));
+      expect(db.projectTask.update).not.toHaveBeenCalled();
+      expect(db.inboxTask.update).not.toHaveBeenCalled();
+    });
+
+    it('retains private entry authorization', async () => {
+      const { db, service, item } = setup(source);
+      db.projectPlannerItem.findUnique.mockResolvedValue({ ...item, assignees: [] });
+      await expect(service.updateItem('item', actor, { completed: true })).rejects.toThrow(ForbiddenException);
+      expect(db.projectPlannerItem.update).not.toHaveBeenCalled();
+    });
+  });
+
+  it('preserves current-project permission checks', async () => {
+    const { db, access, service, item } = setup('project');
+    item.task!.projectId = 'inaccessible';
+    access.assertProjectAccess.mockImplementation(async id => {
+      if (id === 'inaccessible') throw new ForbiddenException();
+    });
+    await expect(service.updateItem('item', actor, { completed: true })).rejects.toThrow(ForbiddenException);
+    expect(db.projectPlannerItem.update).not.toHaveBeenCalled();
+  });
+
+  it('filters archive on planner entries while preserving source access filters', async () => {
+    const { db, service } = setup('project');
+    await service.listAccount(actor);
+    const where = db.projectPlannerItem.findMany.mock.calls[0][0].where;
+    expect(where.archived).toBe(false);
+    expect(where.OR[0].task).toEqual({ project: { id: 'project' } });
+    expect(where.OR[2].inboxTask).toEqual({ assignees: { some: { userId: actor.id } } });
+    expect(where.NOT).toEqual({ assignees: { some: { userId: actor.id, excluded: true } } });
+  });
+
+  it('keeps the independent completion route validated and authenticated', async () => {
+    const { db, service } = setup('project');
+    const controller = new ProjectPlannerController(service);
+    const request = { user: actor } as AuthenticatedRequest;
+    expect(() => controller.updateCompletion('item', {}, request)).toThrow(BadRequestException);
+    await controller.updateCompletion('item', { completed: false }, request);
+    expect(db.projectPlannerItem.update).toHaveBeenCalledWith(expect.objectContaining({ data: { completed: false } }));
+    expect(db.projectTask.update).not.toHaveBeenCalled();
+  });
+});
