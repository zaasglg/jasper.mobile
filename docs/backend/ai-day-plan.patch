+import { Body, Controller, Post, Request, UseGuards } from '@nestjs/common';
+import { JwtAuthGuard } from '../../auth/jwt-auth.guard';
+import { AuthenticatedRequest } from '../../auth/authenticated-request';
+import { AiDayPlanDto } from '../dto/ai-day-plan.dto';
+import { AiDayPlanService } from '../services/ai-day-plan.service';
+
+@Controller('ai/assistant')
+@UseGuards(JwtAuthGuard)
+export class AiDayPlanController {
+  constructor(private readonly plans: AiDayPlanService) {}
+
+  @Post('day-plan')
+  suggest(@Body() dto: AiDayPlanDto, @Request() req: AuthenticatedRequest) {
+    return this.plans.suggest(dto, req.user);
+  }
+}
