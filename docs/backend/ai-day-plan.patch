@@ -0,0 +1,94 @@
+import { ConfigService } from '@nestjs/config';
+import { ForbiddenException, HttpException, ServiceUnavailableException } from '@nestjs/common';
+import { validate } from 'class-validator';
+import OpenAI from 'openai';
+import { PrismaService } from '../../prisma/prisma.service';
+import { ProjectAccessService } from '../../project-access/project-access.service';
+import { AiDayPlanService } from './ai-day-plan.service';
+import { AiDayPlanDto } from '../dto/ai-day-plan.dto';
+import { AuthenticatedRequest } from '../../auth/authenticated-request';
+
+jest.mock('../../prisma/prisma.service', () => ({ PrismaService: class {} }));
+const create = jest.spyOn(OpenAI.Chat.Completions.prototype, 'create');
+const actor = { id: 'user', role: 'EXECUTOR', name: 'Test' } as AuthenticatedRequest['user'];
+const dto = { workspaceId: 'w', date: '2026-11-24' };
+const task = { id: 't', projectId: 'p', title: 'Real task', end: new Date('2026-11-24T00:00:00Z'), priority: 'HIGH' };
+const suggestion = { taskId: 't', reason: 'Срок сегодня', durationMinutes: 30 };
+const response = (items: unknown[]) => ({ id: 'test', object: 'chat.completion' as const, created: 0, model: 'test', choices: [{ index: 0, finish_reason: 'stop' as const, logprobs: null, message: { role: 'assistant' as const, content: JSON.stringify({ items }), refusal: null } }] });
+const prisma = {
+  kanbanColumn: { findMany: jest.fn() },
+  projectPlannerItem: { findMany: jest.fn() },
+  projectTask: { findMany: jest.fn() },
+};
+const access = { assertWorkspaceAccess: jest.fn(), projectFilter: jest.fn() };
+let service: AiDayPlanService;
+beforeEach(() => {
+  jest.clearAllMocks();
+  prisma.kanbanColumn.findMany.mockResolvedValue([{ projectId: 'p', statusMap: 'TODO' }]);
+  prisma.projectPlannerItem.findMany.mockResolvedValue([{ taskId: 'existing' }]);
+  prisma.projectTask.findMany.mockResolvedValue([task]);
+  access.assertWorkspaceAccess.mockResolvedValue(undefined);
+  access.projectFilter.mockResolvedValue({ id: { in: ['p'] } });
+  const config = { get: (name: string, fallback?: string) => name === 'DEEPSEEK_API_KEY' ? 'test-key' : fallback } as ConfigService;
+  service = new AiDayPlanService(config, prisma as unknown as PrismaService, access as unknown as ProjectAccessService);
+  create.mockResolvedValue(response([suggestion]));
+});
+
+test('read-only inference scopes tasks to actor, workspace, active columns and excludes existing planner links', async () => {
+  expect(await service.suggest(dto, actor)).toEqual({ date: dto.date, items: [{ ...suggestion, projectId: 'p', title: 'Real task', dueDate: dto.date }] });
+  expect(access.assertWorkspaceAccess).toHaveBeenCalledWith('w', actor);
+  expect(prisma.projectTask.findMany.mock.calls[0][0].where).toMatchObject({
+    workspaceId: 'w', archived: false, progress: { lt: 100 },
+    assignees: { some: { userId: 'user' } }, id: { notIn: ['existing'] },
+    OR: [{ projectId: 'p', status: 'TODO' }],
+  });
+  expect(prisma.kanbanColumn.findMany.mock.calls[0][0].where).toMatchObject({ archivedAt: null,
+    project: { AND: [{ id: { in: ['p'] } }, { workspaceId: 'w', archivedAt: null }] } });
+  expect(prisma.projectPlannerItem.findMany).toHaveBeenCalledWith({
+    where: { task: { workspaceId: 'w' } }, select: { taskId: true },
+  });
+  const request = create.mock.calls[0][0];
+  expect(request.tools).toBeUndefined();
+  expect(request.response_format).toEqual({ type: 'json_object' });
+  expect(request.messages[0].content).toContain('untrusted data');
+});
+
+test('validates AI ids, duplicates, budgets and uses canonical task fields', async () => {
+  const canonical = service.validate({ items: [{ ...suggestion, title: 'fake', projectId: 'other' }] }, [task]);
+  expect(canonical[0].title).toBe('Real task');
+  expect(canonical[0].projectId).toBe('p');
+  for (const items of [[], [{ ...suggestion, taskId: 'invented' }], [suggestion, suggestion],
+    [{ ...suggestion, durationMinutes: -1 }], [{ ...suggestion, reason: '' }]]) {
+    expect(() => service.validate({ items }, [task])).toThrow();
+  }
+  create.mockResolvedValue(response([{ ...suggestion, taskId: 'invented' }]));
+  await expect(service.suggest(dto, actor)).rejects.toBeInstanceOf(ServiceUnavailableException);
+});
+
+test('authorization is checked before data lookup or inference', async () => {
+  access.assertWorkspaceAccess.mockRejectedValue(new ForbiddenException());
+  await expect(service.suggest(dto, actor)).rejects.toBeInstanceOf(ForbiddenException);
+  expect(prisma.projectTask.findMany).not.toHaveBeenCalled();
+  expect(create).not.toHaveBeenCalled();
+});
+
+test('empty eligible task list returns empty without AI and failures are explicit', async () => {
+  prisma.projectTask.findMany.mockResolvedValueOnce([]);
+  expect(await service.suggest(dto, actor)).toEqual({ date: dto.date, items: [] });
+  expect(create).not.toHaveBeenCalled();
+  create.mockRejectedValue(new Error('Provider unavailable'));
+  await expect(service.suggest(dto, actor)).rejects.toBeInstanceOf(ServiceUnavailableException);
+});
+
+test('caps paid inference requests per actor', async () => {
+  for (let i = 0; i < 5; i++) await service.suggest(dto, actor);
+  await expect(service.suggest(dto, actor)).rejects.toBeInstanceOf(HttpException);
+  expect(create).toHaveBeenCalledTimes(5);
+});
+
+test('rejects invalid DTO and impossible calendar dates', async () => {
+  expect(await validate(Object.assign(new AiDayPlanDto(), dto))).toHaveLength(0);
+  expect((await validate(Object.assign(new AiDayPlanDto(), { date: 'bad', workspaceId: '' }))).length).toBeGreaterThan(0);
+  await expect(service.suggest({ ...dto, date: '2026-02-31' }, actor)).rejects.toThrow('Invalid date');
+  expect(create).not.toHaveBeenCalled();
+});
