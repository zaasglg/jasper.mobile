diff --git a/src/project-planner/planner-schedule.ts b/src/project-planner/planner-schedule.ts
new file mode 100644
--- /dev/null
+++ b/src/project-planner/planner-schedule.ts
@@ -0,0 +1,23 @@
+import { BadRequestException } from '@nestjs/common';
+
+export interface PlannerScheduleInput {
+  scheduledAt?: string | null;
+  plannedDate?: string;
+}
+
+/** A calendar day is stored as DATE; a missing start never reserves midnight. */
+export function plannerSchedulePatch(data: PlannerScheduleInput): { scheduledAt?: Date | null; plannedDate?: Date | null } {
+  if (data.scheduledAt === undefined && data.plannedDate === undefined) return {};
+  if (data.scheduledAt == null && !data.plannedDate) {
+    throw new BadRequestException('Choose a day for an untimed planner entry');
+  }
+  let plannedDate: Date | null = null;
+  if (data.plannedDate !== undefined) {
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(data.plannedDate)) throw new BadRequestException('Invalid planner day');
+    plannedDate = new Date(`${data.plannedDate}T00:00:00.000Z`);
+    if (!Number.isFinite(plannedDate.getTime()) || plannedDate.toISOString().slice(0, 10) !== data.plannedDate) throw new BadRequestException('Invalid planner day');
+  }
+  const scheduledAt = data.scheduledAt ? new Date(data.scheduledAt) : null;
+  if (scheduledAt && !Number.isFinite(scheduledAt.getTime())) throw new BadRequestException('Invalid planner time');
+  return { plannedDate, scheduledAt };
+}
