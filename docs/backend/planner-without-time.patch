+++ b/src/project-planner/planner-day.spec.ts
@@ -0,0 +1,41 @@
+import { BadRequestException } from '@nestjs/common';
+import { plannerSchedulePatch } from './planner-schedule';
+import { ProjectPlannerController } from './project-planner.controller';
+import { ProjectPlannerService } from './project-planner.service';
+import { AuthenticatedRequest } from '../auth/authenticated-request';
+
+describe('Planner calendar day without an execution time', () => {
+  it('stores a DATE and a null start instead of reserving midnight', () => {
+    expect(plannerSchedulePatch({ plannedDate: '2026-11-18', scheduledAt: null })).toEqual({ plannedDate: new Date('2026-11-18T00:00:00.000Z'), scheduledAt: null });
+  });
+  it('can remove the execution time with a day-only update', () => {
+    expect(plannerSchedulePatch({ plannedDate: '2026-11-19' }).scheduledAt).toBeNull();
+  });
+  it('retains the old no-op behavior when scheduling fields are absent', () => {
+    expect(plannerSchedulePatch({})).toEqual({});
+  });
+  it('assigns an instant and clears an obsolete untimed day for older clients', () => {
+    expect(plannerSchedulePatch({ scheduledAt: '2026-11-18T04:00:00.000Z' })).toEqual({ scheduledAt: new Date('2026-11-18T04:00:00.000Z'), plannedDate: null });
+  });
+  it.each(['2026-02-30', '2026-13-01', '2026-11-18T00:00:00Z', 'bad'])('rejects invalid calendar date %s', plannedDate => {
+    expect(() => plannerSchedulePatch({ plannedDate, scheduledAt: null })).toThrow(BadRequestException);
+  });
+  it('rejects clearing the start without a calendar day', () => {
+    expect(() => plannerSchedulePatch({ scheduledAt: null })).toThrow(BadRequestException);
+  });
+  it('routes personal, project and Inbox day entries without a fabricated time', async () => {
+    const service = { createWorkspaceTask: jest.fn(), add: jest.fn(), addInboxTask: jest.fn(), updateItem: jest.fn() };
+    const controller = new ProjectPlannerController(service as unknown as ProjectPlannerService);
+    const request = { user: { id: 'user' } } as AuthenticatedRequest;
+    const day = { plannedDate: '2026-11-18' };
+    await controller.createDayTask({ title: 'Day', ...day }, request);
+    await controller.addDayProjectTask('project', { taskId: 'task', ...day }, request);
+    await controller.addDayInboxTask({ inboxTaskId: 'inbox', ...day }, request);
+    await controller.updateSchedule('entry', day, request);
+    expect(service.createWorkspaceTask).toHaveBeenCalledWith(null, request.user, { title: 'Day', ...day, scheduledAt: null });
+    expect(service.add).toHaveBeenCalledWith('project', 'task', request.user, { taskId: 'task', ...day, scheduledAt: null });
+    expect(service.addInboxTask).toHaveBeenCalledWith(null, 'inbox', request.user, { inboxTaskId: 'inbox', ...day, scheduledAt: null });
+    expect(service.updateItem).toHaveBeenCalledWith('entry', request.user, { ...day, scheduledAt: null });
+    expect(() => controller.createDayTask({ title: 'Missing day' }, request)).toThrow(BadRequestException);
+  });
+});
