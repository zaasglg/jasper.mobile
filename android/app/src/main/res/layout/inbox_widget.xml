<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/inbox_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/inbox_widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Инбокс"
            android:textColor="#171821"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/inbox_widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/inbox_widget_badge"
            android:text="0"
            android:textColor="#4F46E5"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/inbox_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="Быстрых задач пока нет"
        android:textColor="#9297A5"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/inbox_widget_task_1"
        style="@style/InboxWidgetTask" />

    <TextView
        android:id="@+id/inbox_widget_task_2"
        style="@style/InboxWidgetTask" />

    <TextView
        android:id="@+id/inbox_widget_task_3"
        style="@style/InboxWidgetTask" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Открыть Инбокс  →"
        android:textColor="#6366F1"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
